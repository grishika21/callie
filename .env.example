# Copy to .env and fill in. Never commit .env.
# The values below match the local Docker databases started by docker/dev-db.sh.

# --- Databases (the app only ever reads through these) -----------------------
SQLITE_PATH=data/bookstore.db

# Use READ-ONLY database users here. Production examples:
#   POSTGRES_URL=postgresql://talktable_ro:<password>@<host>.neon.tech/bookstore?sslmode=require
#   MONGO_URL=mongodb+srv://talktable_ro:<password>@<cluster>.mongodb.net
POSTGRES_URL=postgresql://talktable_ro:talktable_ro_dev@localhost:5433/bookstore
MONGO_URL=mongodb://talktable_ro:talktable_ro_dev@localhost:27017/?authSource=bookstore
MONGO_DB=bookstore

# Write-capable URLs, used ONLY by the seed scripts in data/seed/.
# Leave them unset on Hugging Face Spaces.
POSTGRES_SEED_URL=postgresql://talktable:talktable_dev@localhost:5433/bookstore
MONGO_SEED_URL=mongodb://root:root_dev@localhost:27017/?authSource=admin

# --- TalkTable Copilot: Support Desk (not used by TalkTable itself) ------------
# Its own Postgres login, which may read 9 sales tables and INSERT support tickets (named
# columns only): no UPDATE, DELETE or TRUNCATE. docker/dev-db.sh creates it with this
# password; for an existing container or Neon run: python -m data.seed.desk_role
TALKTABLE_DESK_PASSWORD=talktable_desk_dev
DESK_POSTGRES_URL=postgresql://talktable_desk:talktable_desk_dev@localhost:5433/bookstore
# Signs the 15-minute tokens the Copilot sends to the Support Desk. Required; make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
COPILOT_JWT_SECRET=
# Staff accounts: python -m copilot.auth add-user <name> --role agent|viewer
# COPILOT_USERS_PATH=data/copilot_users.yaml
# COPILOT_AUDIT_PATH=data/audit/copilot.jsonl
# DESK_PORT=8765
# DESK_TICKETS_PER_HOUR=20

# --- TalkTable Copilot: agent model (production: local Ollama) --------------------
# Measured (docs/copilot_plan.md): qwen3:4b-instruct-2507-q4_K_M ~1.4 s/turn with every
# layer on a 4 GB GPU; qwen3:14b is more accurate but ~20 s/turn, too slow for voice.
AGENT_PROVIDER=ollama          # ollama | openai | groq (the last two for testing only)
AGENT_MODEL=qwen3:4b-instruct-2507-q4_K_M
# AGENT_NUM_GPU=37             # layers on the GPU; 37 = all of the 4B (unset: Ollama decides)
# AGENT_NUM_CTX=4096
# The LLM of the Copilot's own TalkTable process ("default" = LLM_MODEL above). The 4B
# avoids model swapping on a small GPU: 8-26 s per spoken question instead of 124-140 s.
# COPILOT_TALKTABLE_LLM=qwen3:4b-instruct-2507-q4_K_M

# Hosted models (testing; and the public demo on Hugging Face, which has no GPU):
#   AGENT_PROVIDER=groq  AGENT_MODEL=openai/gpt-oss-120b  AGENT_REASONING_EFFORT=low
#   AGENT_FALLBACK_MODELS=qwen/qwen3.8-27b@none,openai/gpt-oss-20b@low   (each Groq model has its own rate limit)

# --- TalkTable Copilot: phone line (Twilio) ---------------------------------------
# TWILIO_AUTH_TOKEN=               # checks Twilio's signature on every request (required)
# TWILIO_ACCOUNT_SID=              # requests for another account are refused
# TWILIO_PHONE_NUMBER=+1...        # only for python -m copilot.phone.setup
# PHONE_PUBLIC_URL=https://...     # the URL Twilio calls; unset: taken from the request
# PHONE_TRANSFER_NUMBER=+1...      # "talk to a person"; unset: callers are offered a callback ticket
# PHONE_STT=whisper                # or groq: Groq's Whisper, with PHONE_STT_MODEL as the local fallback
# PHONE_STT_MODEL=small.en
# PHONE_MAX_CALLS=2  PHONE_MAX_MINUTES=10  PHONE_CALLS_PER_NUMBER_HOUR=5

# --- TalkTable Copilot: speech (CPU) ---------------------------------------------
# COPILOT_STT_MODEL=small.en        # faster-whisper; base.en is faster but less accurate
# COPILOT_TTS=piper                 # piper | browser | none
# COPILOT_TTS_VOICE=en_US-lessac-medium   # in data/voices/ (python -m piper.download_voices ...)

# --- LLM ---------------------------------------------------------------------
LLM_PROVIDER=ollama          # ollama | hf | groq
# LLM_MODEL picks the database and writes the answers. LLM_QUERY_MODEL (optional)
# writes the SQL / Mongo queries; leave it empty to use LLM_MODEL for everything
# (do that with hf / groq). Measured on a 4 GB laptop GPU, 6 test questions:
#   qwen3:14b + LLM_QUERY_MODEL=qwen2.5-coder:7b   6/6, ~62 s/question
#   qwen3:14b alone                                6/6, ~52 s/question
#   qwen2.5-coder:7b alone                         6/6 queries, ~17 s/question, but its
#                                                  answers sometimes invent details
#   mistral:7b alone                               4/6, ~25 s/question
# Hosted examples: Qwen/Qwen2.5-72B-Instruct (hf), llama-3.3-70b-versatile (groq).
LLM_MODEL=qwen3:14b
LLM_QUERY_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434
HF_TOKEN=
GROQ_API_KEY=
LLM_TIMEOUT_SECONDS=180

# On a Hugging Face Space there is no .env: set POSTGRES_URL, MONGO_URL and the API key
# as Space *secrets*, LLM_PROVIDER / LLM_MODEL / MONGO_DB as variables, and leave
# LLM_QUERY_MODEL unset. Step by step: docs/deploy.md
#   LLM_PROVIDER=groq   LLM_MODEL=llama-3.3-70b-versatile   GROQ_API_KEY=gsk_...
#   LLM_PROVIDER=hf     LLM_MODEL=Qwen/Qwen2.5-72B-Instruct HF_TOKEN=hf_...

# --- Schema vectors --------------------------------------------------------------
# auto: NumPy in memory for small schemas; Qdrant when QDRANT_URL is set or the schemas
# have VECTOR_STORE_AUTO_TABLES tables or more (then vectors persist and restarts only
# embed what changed). Or force one with numpy / qdrant.
VECTOR_STORE=auto
# QDRANT_URL=http://localhost:6333     # a Qdrant server; unset = embedded in QDRANT_PATH
# QDRANT_API_KEY=
# QDRANT_PATH=data/qdrant              # embedded mode: one process at a time per folder

# --- Answer cache --------------------------------------------------------------
# Repeated questions reuse their saved query (re-run on the current data) and skip the LLM.
CACHE_ENABLED=true
CACHE_PATH=data/answer_cache.sqlite
CACHE_TTL_HOURS=168

# --- Limits ------------------------------------------------------------------
MAX_ROWS=200
QUERY_TIMEOUT_SECONDS=5
LOG_LEVEL=INFO
